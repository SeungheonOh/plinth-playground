 -----------------------------------------------------------------------------
 -- ToDo:
 
@@ -195,6 +200,10 @@ main' postLoadMode units dflags0 args flagWarnings = do
                                          DoRun    -> 0
                                          _other   -> 1
                         }
+#if defined(PLINTH)
+                            `gopt_set` Opt_WriteIfSimplifiedCore
