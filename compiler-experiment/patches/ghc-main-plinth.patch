@@ -282,6 +291,25 @@ main' postLoadMode units dflags0 args flagWarnings = do
   -- Must do this before loading plugins
   liftIO $ initUniqSupply (initialUnique dflags6) (uniqueIncrement dflags6)
 
+#if defined(PLINTH)
+  let plinthPluginModuleName = mkModuleName "Plinth.Plugin"
+      plinthPluginArgs =
+        [ opt
+        | (moduleName, opt) <- pluginModNameOpts dflags6
+        , moduleName == plinthPluginModuleName
+        ]
+      plinthStaticPlugin =
+        StaticPlugin
+          (PluginWithArgs Plinth.Plugin.plugin plinthPluginArgs)
+          False
+
+  modifySession $ \hscEnv ->
+    let oldPlugins = hsc_plugins hscEnv
+    in hscEnv
+         { hsc_plugins = oldPlugins { staticPlugins = [plinthStaticPlugin] }
+         }
+#endif
