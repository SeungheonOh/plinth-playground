  , cardano-haskell-packages 2026-08-05T05:00:53Z

constraints:
  , setup.optparse-applicative >=0.19.0.0

allow-newer:
  , deriving-aeson:aeson
  , microstache:aeson
  , turtle:containers
  , turtle:optparse-applicative
  , inline-r:singletons-th
  , inline-r:aeson
  , inline-r:text
  , inline-r:template-haskell
  , inline-r:deepseq
  , inline-r:bytestring
  , inline-r:containers
  , inline-r:primitive

source-repository-package
  type: git
  location: https://github.com/hsyl20/cardano-base
  subdir: cardano-crypto-class
          cardano-crypto-praos
  tag: 055ebbcc73e1cb234f1fd3fa237a4fb087130183

source-repository-package
  type: git
  location: https://github.com/haskell-cryptography/blst-clib
  tag: 0fd1d38d5ceed5529ac646efae3095b493a97927

source-repository-package
  type: git
  location: https://github.com/haskell-cryptography/secp256k1-clib
  tag: 211b95baad422966c9e719ed70cbc189c58eaae5

packages:
  ./uplc-ghc-wasm-9.12
  ./browser-modules
  ./plutarch-browser
  ./.compiler-deps/vendor/foundation/basement
  ./.compiler-deps/vendor/double-conversion-2.0.5.0
  ./.compiler-deps/vendor/network
  ./.compiler-deps/vendor/ram
  ./.compiler-deps/vendor/libsodium-clib
  ./.compiler-deps/vendor/cborg/cborg
  ./.compiler-deps/vendor/memory-0.18.0
  ./.compiler-deps/vendor/crypton-1.1.4
  ./.compiler-deps/plutus/plutus-tx-plugin
  ./.compiler-deps/plutus/plutus-tx
  ./.compiler-deps/plutus/plutus-core
  ./.compiler-deps/plutus/plutus-metatheory
  ./.compiler-deps/plutus/plutus-ledger-api
  ./.compiler-deps/plutarch

package secp256k1-clib
  flags: +schnorrsig +recovery +ecdh +extrakeys

package cardano-crypto-class
  flags: +use-haskell-clibs

package cardano-crypto-praos
  flags: +use-haskell-clibs

package sodium-clib
  configure-options: --enable-pie=no

package plutus-core
  flags: +do-not-build-plutus-exec

package plutus-tx-plugin
  profiling: False

package plutarch
  ghc-options: -Wwarn

tests: False
benchmarks: False
documentation: False
write-ghc-environment-files: never
