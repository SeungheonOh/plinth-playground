cabal-version: 3.0
name: uplc-ghc-wasm-port
version: 0.1.0.0
build-type: Simple
license: BSD-3-Clause

executable uplc-ghc-9-12
  main-is: Main.hs
  hs-source-dirs: src
  default-language: Haskell2010
  default-extensions:
    NoImplicitPrelude
    ScopedTypeVariables
    BangPatterns
  cpp-options:
    -DPLINTH
  ghc-options:
    -Wall
    -Wnoncanonical-monad-instances
    -Wnoncanonical-monoid-instances
    -rtsopts=all
    -with-rtsopts=-K512M
  build-depends:
    base >=4 && <5,
    array >=0.5 && <0.6,
    bytestring >=0.11 && <0.13,
    directory >=1.3 && <1.4,
    process >=1.6 && <1.7,
    filepath >=1.4 && <1.6,
    containers >=0.6 && <0.8,
    transformers >=0.6 && <0.7,
    ghc >=9.12 && <9.13,
    ghc-boot >=9.12 && <9.13,
    ghci >=9.12 && <9.13,
    plutus-tx-plugin ==1.66.0.0
