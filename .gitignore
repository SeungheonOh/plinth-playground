# Compiler sources and reproducible build inputs are tracked. Large dependency
# checkouts, Cabal output, and generated WASM products remain ignored.
/compiler-experiment/*
!/compiler-experiment/README.md
!/compiler-experiment/UplcGhcBrowser.hs
!/compiler-experiment/DecodeUplc.hs
!/compiler-experiment/BrowserPlinth.hs
!/compiler-experiment/BrowserPlinthWithUtils.hs
!/compiler-experiment/BrowserPlinthMulti.hs
!/compiler-experiment/BrowserLocalMath.hs
!/compiler-experiment/BrowserPlutarch.hs
!/compiler-experiment/empty-wasi-shim.c
!/compiler-experiment/build-uplc-ghc-wasm.sh
!/compiler-experiment/build-browser-rootfs.sh
!/compiler-experiment/test-uplc-ghc-browser.sh
!/compiler-experiment/test-uplc-ghc-browser.mjs
!/compiler-experiment/browser-smoke.mjs
!/compiler-experiment/split-rootfs.mjs
!/compiler-experiment/cabal-9.12.project
!/compiler-experiment/browser-modules/
/compiler-experiment/browser-modules/*
!/compiler-experiment/browser-modules/Utils.hs
!/compiler-experiment/browser-modules/plinth-browser-utils.cabal
!/compiler-experiment/plutarch-browser/
!/compiler-experiment/plutarch-browser/**
!/compiler-experiment/uplc-ghc-wasm-9.12/
/compiler-experiment/uplc-ghc-wasm-9.12/*
!/compiler-experiment/uplc-ghc-wasm-9.12/uplc-ghc-wasm-port.cabal
!/compiler-experiment/patches/
!/compiler-experiment/patches/**
!/compiler-experiment/scripts/
!/compiler-experiment/scripts/**
tsconfig.tsbuildinfo

# The split browser compiler image under /public/runtime is tracked so
# Cloudflare Git and direct-upload deployments are self-contained.
